# Supabase Configuration
# Production values: Supabase Dashboard > Project Settings > API
# Staging values: project univertex-staging (P0-02) — JANGAN tertukar saat db push.
# Mapping (lihat docs/RUNBOOK.md §0):
#   production (Vercel production) -> URL + anon PROD
#   preview/staging (Vercel preview + branch staging) -> URL + anon STAGING

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Staging (P0-02) — placeholder saja, tanpa secret. Isi dari dashboard staging.
# VITE_SUPABASE_URL_STAGING=https://your-staging-ref.supabase.co
# VITE_SUPABASE_ANON_KEY_STAGING=your-staging-anon-key-here

# Development Mode (optional)
# Set to 'development' for dev mode, 'production' for prod
VITE_APP_ENV=development

# API Base URL (optional, if using custom API)
# VITE_API_BASE_URL=https://api.example.com

# Feature Flags (optional)
# VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_DEBUG=true

# SENTRY
SENTRY_DSN=https://